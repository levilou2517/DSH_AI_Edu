# == 版本控制机制决策（见 构建/版本控制机制定稿.md）==
# A 域仓库：入 git = 教材md/材料模板/构建文档/scripts/技能；不入 = venv/db/运行JSON/tar
# B 域仓库（~/.dsh/.agent-presets/）独立管运行预设，不在此仓库。

# Python 虚拟环境（按用户要求走文件夹内 venv，不提交）
.venv/

# SQLite 数据文件（模拟/运行时数据，提交 schema+种子脚本，不提交 .db 二进制）
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/**/*.log

# == v0.4.0 数据分层：个人数据与 L0 原始材料不入库 ==
# 已入库的历史运行 JSON（current_lesson/current_quiz/last_eval/lesson_plan_candidates）
# 保留在版本控制中作 schema 参照，不删除；此处只排除此后新增的敏感层。
# L0 原始材料：课堂记录/微格转写/教师笔记（含真实师生对话，不外发）
data/shiban/raw/
# 教师个人画像与偏好（个人数据）
data/shiban/teacher_profile.json
# 新增的 L1/L2 运行产物（微格评价、成长报告、归档索引、任务组织图）
data/shiban/last_microeval.json
data/shiban/teacher_growth_report.json
data/shiban/*.index.json

# 分享/发布用临时 tar 包（决策3：不入库，为拆解副本）
*.tar.gz

# Python 缓存 & 构建产物
__pycache__/
*.pyc
*.pyo

# 系统/编辑器
.DS_Store
*.swp
.idea/
.vscode/

# 环境变量/密钥（绝不入库）
.env
*.env.local