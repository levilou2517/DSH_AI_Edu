#!/usr/bin/env bash
# shiban-store — 师伴持久数据层启动器（零依赖，调用 store CLI）
# 用法：bin/shiban-store <args...>（等价于 python services/shiban_cli.py <args...>）
# 数据位置由 SHIBAN_ROOT 决定（正式部署指向本体之外的「素材库根」）；
# 未设置时才回退到 ~/.shiban/data。本仓库不携带任何运行数据。
# Python 解析顺序：SHIBAN_PY 环境变量 > 项目 .venv/bin/python > 系统 python3。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${SHIBAN_PY:-}" ]; then
  PY="$SHIBAN_PY"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  # Windows 上的 python3 可能是 Microsoft Store 存根（存在但运行即失败），
  # 因此逐个实际执行 -E -c '' 验证，能跑通的才用。
  # DSH 自带解释器不写死盘符：由本文件位置推出 DSH_HOME
  # （<DSH_HOME>/WorkSpace/<ws>/bin/shiban-store → 上溯三级），并允许 SHIBAN_PY 覆盖。
  DSH_HOME_GUESS="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." 2>/dev/null && pwd || true)"
  CANDIDATES="python3 python"
  for py in "$HOME/.dsh/dsh-runtimes"/*/dependencies/python/python.exe \
            "${DSH_HOME_GUESS:-/nonexistent}/dsh-runtimes"/*/dependencies/python/python.exe; do
    [ -n "$py" ] && CANDIDATES="$CANDIDATES $py"
  done
  PY=""
  for cand in $CANDIDATES; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -E -c '' >/dev/null 2>&1; then
      PY="$cand"
      break
    fi
  done
  [ -n "$PY" ] || PY="$(command -v python3 || echo python)"
fi

if [ -d "$ROOT/services" ]; then
  export PYTHONPATH="$ROOT/services${PYTHONPATH:+:$PYTHONPATH}"
fi

# Windows 关键修正：中文 Windows 上 Python 的 stdio 默认走 GBK(cp936)，
# 而素材 Tool 按 UTF-8 解析本 CLI 的 stdout（JSON.parse），中文会因此解析失败。
# 注意：素材文件本身的读写已在代码里显式指定 encoding="utf-8"，不依赖本设置；
# shiban_cli.py 亦在进程内 reconfigure 为 UTF-8。此处设置属双保险，
# 同时覆盖「绕过本启动器、直接调用 python」以及后续新增代码。
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

exec "$PY" "$ROOT/services/shiban_cli.py" "$@"
