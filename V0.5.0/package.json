{
  "name": "@levilou/dsh-shiban",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "师伴（ShiBan）—— 面向师范生与新手教师的循证教学辅助 Agent。装完是空壳，教材与素材由你导入并逐步积累。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "vendor/bin/",
    "vendor/services/*.py",
    "skills/",
    "framework/",
    "contracts/",
    "docs/",
    "presets/",
    "cordis.patch.yml",
    "VERSION",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "shiban": {
    "presetId": "ShiBan_V0_5_0",
    "presetName": "师伴 v0.5.0",
    "dataScheme": "shiban-data/1",
    "requires": {
      "python": ">=3.10",
      "tested": [
        "3.10",
        "3.11",
        "3.12",
        "3.13"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "education",
    "teacher",
    "lesson-plan",
    "agent-preset",
    "循证教学",
    "师范生"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levilou2517/shiban-dist.git"
  },
  "homepage": "https://github.com/levilou2517/shiban-dist#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"const{execSync}=require('child_process');try{execSync('find vendor -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true',{stdio:'ignore'})}catch(e){}\"",
    "clean": "find vendor -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true"
  }
}
